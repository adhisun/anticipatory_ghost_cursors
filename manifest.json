{
  "manifest_version": 3,
  "name": "Ghost Cursors - Anticipatory Cross-Tab Agent",
  "version": "1.0.0",
  "description": "Anticipatory cross-tab agent that extracts context from one tab and projects actionable micro-UI with animated ghost cursors in target tabs.",
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Ghost Cursors",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "config/domain_mappings.js",
        "content/dom_resolver.js",
        "content/ghost_ui.js",
        "content/ghost_cursor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "demo/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
